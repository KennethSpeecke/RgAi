@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Dense="false" Class="py-3">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
        <MudSpacer />
        <MudText Typo="Typo.h6" Class="font-weight-bold">RgAi Studio lmao</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Apartment">@TenantName</MudChip>
        <MudAvatar Color="Color.Secondary" Class="ms-3">
            <ChildContent>
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle"/>
            </ChildContent>
        </MudAvatar>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Color="Color.Surface">
        <MudDrawerHeader Class="d-flex justify-center">
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="font-weight-bold">Menu</MudText>
        </MudDrawerHeader>
        <MudDivider />
        <MudNavMenu Class="px-2">
            <MudNavLink Icon="@Icons.Material.Filled.Chat" Href="/">Chat</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Code" Href="/code">Code Knowledge Base</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Settings" Href="/settings">Settings</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Info" Href="/about">About</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="mud-main-content-full">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6 mud-height-full">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private string TenantName { get; } = "default";

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Black = "#0C1220",
            Background = "#0B1120",
            Surface = "#111827",
            DrawerBackground = "#0f172a",
            AppbarBackground = "#111827",
            AppbarText = "#e5e7eb",
            TextPrimary = "#e5e7eb",
            TextSecondary = "#e5e7eb",
            Primary = "#7c3aed",
            Secondary = "#22d3ee",
            Info = "#60a5fa",
            Success = "#22c55e",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Tertiary = "#a78bfa"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Segoe UI", "sans-serif" },
                FontSize = "0.875rem",
                LineHeight = "1.6rem"
            },
            H6 = new H6Typography()
            {
                FontSize = "1.25rem",
                FontWeight = "600rem",
                LineHeight = "1.4rem"
            }
        }
    };
}
