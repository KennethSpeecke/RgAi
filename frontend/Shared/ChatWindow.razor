@using MudBlazor
@using frontend.Models

<MudPaper Class="h-100 pa-4" Elevation="1">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h6">Conversation</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">AI output, memory context, and realtime response history.</MudText>
    </MudStack>

    <div class="chat-window-container mt-3">
        @if (Messages.Count == 0)
        {
            <MudPaper Class="pa-4" Elevation="0" Style="background:#111827; border:1px solid rgba(148,163,184,0.15);">
                <MudText Typo="Typo.body2" Color="Color.Secondary">No messages yet. Send a prompt to begin your session.</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var message in Messages)
            {
                <MudPaper Class="message-card mb-3" Elevation="0" Style="@(message.Role == "user" ? "background:#111827;" : "background:#1f2937;")">
                    <MudStack Spacing="1">
                        <MudChip T="string" Color="@(message.Role == "user" ? Color.Primary : Color.Secondary)" Variant="Variant.Filled" Size="Size.Small">@message.Role</MudChip>
                        <MudMarkdown Value="@message.Content" HasTableOfContents="false"/>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@message.Timestamp.ToLocalTime()</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
    </div>
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<ChatMessage> Messages { get; set; } = Array.Empty<ChatMessage>();
}
